APP_NAME=AI Driven Fleet Optimization API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=fleetoptimization
