[Unit]
Description=FleetOpt FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fleetopt
Group=fleetopt
WorkingDirectory=/opt/fleetopt/backend
EnvironmentFile=/etc/fleetopt/api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fleetopt/api-venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
