# Public HTTPS hostname. After Oracle assigns an IP, use <IP>.sslip.io.
FLEETOPT_HOSTNAME=203-0-113-10.sslip.io

APP_NAME=AI Driven Fleet Optimization API
APP_VERSION=1.0.0
ENVIRONMENT=production
API_PREFIX=/api

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=fleetoptimization
MONGODB_DB_NAME=fleet_optimization
MONGODB_TARGET_VALIDATION_ENABLED=true
ALLOWED_MONGODB_HOSTS=<cluster-url>
ALLOWED_MONGODB_DATABASES=fleet_optimization

# Access is controlled by the private backend host. Do not use a hidden expiry.
LICENSE_ENFORCEMENT_ENABLED=false

JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

OSRM_BASE_URL=https://router.project-osrm.org
BRANCH_NAME=Colombo Central Branch
BRANCH_ADDRESS=Colombo Central Branch, Colombo, Sri Lanka
BRANCH_LATITUDE=6.9271
BRANCH_LONGITUDE=79.8612

# Local client origins that may call the hosted API during the demonstration.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
